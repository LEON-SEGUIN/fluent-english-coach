# Your secret keys. The app writes the real file (.env) for you when you paste a key in Settings.
# To do it by hand instead: copy this file, name the copy ".env", and paste each key after the = sign.
# Never share or publish the .env file.

# Required. The coach's brain (Claude). Starts with sk-ant-   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recommended. The human voice and the best ears. Starts with sk_   https://elevenlabs.io/app/settings/api-keys
# Allow on the key: Text to Speech, Speech to Text, Voices (read).
ELEVENLABS_API_KEY=

# Optional and free. Backup ears (Whisper). Starts with gsk_   https://console.groq.com/keys
GROQ_API_KEY=
